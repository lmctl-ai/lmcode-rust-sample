program = _lmcode_ schema="../sample.dsl.json" out=ARGV[0];
let doc = json_parse("{ \"\\u0061\" : [1.25,\"x\",true], \"n\":42 }");
print(doc.kind() + ":" + str(doc.len()) + ":" + str(doc.has("a")));
let keys = doc.keys(); print(keys.join(","));
let list = doc.get("a");
print(str(list.at(0).as_float()) + ":" + list.at(1).as_string() + ":" + str(list.at(2).as_bool()));
print(str(doc.get("n").as_int()) + ":" + str(doc.get("n").as_float()));
print(doc.to_json());
end _lmcode_

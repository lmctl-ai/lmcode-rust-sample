program = _lmcode_ schema="../sample.dsl.json";
let path = sample_tmp() + "/ledger.txt";
file_write(path, "one");
file_append(path, "two");
let exists = file_exists(path);
let text = file_read(path);
let lines = file_lines(path);
print(str(exists) + ":" + text + ":" + str(lines.len()));
end _lmcode_

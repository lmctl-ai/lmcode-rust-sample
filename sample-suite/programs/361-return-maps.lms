program = _lmcode_ schema="../sample.dsl.json" out=ARGV[0];
let strings = str_map().set("key", "value");
let ints = int_map().set("count", 7);
let floats = float_map().set("fraction", 1.25);
$return = strings;
$return = ints;
$return = floats;
$return = null;
$return.strings = strings;
$return.ints = ints;
$return.floats = floats;
strings.set("key", "mutated"); ints.clear(); floats.clear();
end _lmcode_
